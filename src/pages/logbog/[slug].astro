---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { withBase } from '../../lib/url';

export async function getStaticPaths() {
  const indlaeg = (await getCollection('logbog')).sort(
    (a, b) => b.data.dato.getTime() - a.data.dato.getTime(),
  );
  return indlaeg.map((post, i) => ({
    params: { slug: post.id },
    props: {
      post,
      nyere: i > 0 ? indlaeg[i - 1] : undefined,
      aeldre: i < indlaeg.length - 1 ? indlaeg[i + 1] : undefined,
    },
  }));
}

const { post, nyere, aeldre } = Astro.props;
const { Content } = await render(post);
const datoFmt = new Intl.DateTimeFormat('da-DK', { day: 'numeric', month: 'long', year: 'numeric' });
---
<BaseLayout title={post.data.title} description={post.data.description} ogType="article">
  <nav class="text-sm" aria-label="Brødkrumme">
    <a href={withBase('/logbog/')} class="text-fjord-600 hover:underline dark:text-fjord-200">← 📖 Logbog</a>
  </nav>

  <article class="mt-6">
    <p class="text-xs font-bold uppercase tracking-[0.15em] text-rav-600 dark:text-rav-500">
      <time datetime={post.data.dato.toISOString()}>{datoFmt.format(post.data.dato)}</time> · Af {post.data.forfatter}
    </p>
    <h1 class="mt-2 font-display text-4xl font-black">{post.data.title}</h1>

    {post.data.billede && (
      <Image src={post.data.billede} alt={post.data.billedeAlt ?? ''}
        class="mt-6 aspect-[16/9] w-full rounded-2xl object-cover"
        widths={[768, 1280]} sizes="(min-width: 1024px) 1024px, 100vw" loading="eager" />
    )}

    <div class="prose prose-slate mt-6 max-w-none prose-headings:font-display dark:prose-invert">
      <Content />
    </div>
  </article>

  <nav class="mt-10 flex justify-between gap-4 text-sm" aria-label="Flere indlæg">
    {aeldre
      ? <a href={withBase(`/logbog/${aeldre.id}/`)} class="text-fjord-600 hover:underline dark:text-fjord-200">← {aeldre.data.title}</a>
      : <span />}
    {nyere
      ? <a href={withBase(`/logbog/${nyere.id}/`)} class="text-right text-fjord-600 hover:underline dark:text-fjord-200">{nyere.data.title} →</a>
      : <span />}
  </nav>
</BaseLayout>
