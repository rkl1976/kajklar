---
/**
 * Live vind-boks for en havn. Henter prognosedata klient-side fra Open-Meteo
 * (DMI's HARMONIE-model, gratis til ikke-kommerciel brug, ingen API-nøgle,
 * CORS-åben, kildeangivelse påkrævet). Viser aktuel vind, vindstød, retning
 * og de kommende timer. Sitet er statisk, så alt hentes i browseren.
 */
interface Props {
  lat: number;
  lng: number;
  titel?: string;
}

const { lat, lng, titel = 'Vind og vejr lige nu' } = Astro.props;
---
<section data-vindboks data-lat={lat} data-lng={lng} class="rounded-xl bg-fjord-100 p-4 dark:bg-slate-800">
  <div class="flex flex-wrap items-baseline justify-between gap-2">
    <h2 class="font-bold">{titel}</h2>
    <span data-vb-badge hidden class="rounded-full px-2.5 py-0.5 text-xs font-semibold"></span>
  </div>

  <div data-vb-skelet class="mt-3 animate-pulse space-y-2" aria-hidden="true">
    <div class="h-8 w-40 rounded bg-fjord-200/70 dark:bg-slate-700"></div>
    <div class="h-4 w-56 rounded bg-fjord-200/70 dark:bg-slate-700"></div>
    <div class="h-16 rounded bg-fjord-200/70 dark:bg-slate-700"></div>
  </div>

  <p data-vb-fejl hidden class="mt-3 text-sm text-slate-600 dark:text-slate-400">
    Vejrdata kunne ikke hentes lige nu. Prøv at genindlæse siden.
  </p>

  <div data-vb-indhold hidden>
    <div class="mt-3 flex items-center gap-4">
      <svg data-vb-pil class="h-10 w-10 shrink-0 text-fjord-600 transition-transform dark:text-fjord-200"
        viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M12 2 L17.5 13 H13.6 V22 H10.4 V13 H6.5 Z" />
      </svg>
      <div>
        <p class="leading-tight">
          <span data-vb-vind class="font-display text-3xl font-black">–</span>
          <span class="text-sm font-semibold">m/s</span>
          <span data-vb-retning class="ml-1 text-sm font-semibold"></span>
        </p>
        <p class="mt-1 text-sm text-slate-600 dark:text-slate-400">
          Vindstød op til <span data-vb-stoed class="font-semibold text-fjord-900 dark:text-slate-100"></span> m/s
          · <span data-vb-temp></span>°
        </p>
      </div>
    </div>

    <h3 class="mt-4 text-xs font-semibold tracking-wide text-slate-600 uppercase dark:text-slate-400">
      De næste timer · m/s
    </h3>
    <ol data-vb-timer class="mt-2 flex gap-2 overflow-x-auto pb-1"></ol>

    <p class="mt-3 text-xs text-slate-600 dark:text-slate-400">
      Prognose fra DMI's HARMONIE-model via
      <a href="https://open-meteo.com/" rel="noopener" class="underline hover:text-fjord-600 dark:hover:text-fjord-200">Open-Meteo</a>
      · opdateret kl. <span data-vb-tid></span>. Tjek altid en aktuel udsigt, før du sejler.
    </p>
  </div>
</section>

<script>
  import { BADGE_FARVER, PIL_PATH, betegnelse, fmt, forecastUrl, niveau, pilRotation, retningTekst } from '../lib/vejr';

  function timeKort(tid: string, ms: number, grader: number): string {
    return `<li class="flex min-w-13 flex-col items-center gap-1 rounded-lg bg-white/70 px-2 py-2 dark:bg-slate-900/50">
      <span class="text-xs font-semibold text-slate-600 dark:text-slate-400">${tid.slice(11, 16)}</span>
      <svg class="h-4 w-4 text-fjord-600 dark:text-fjord-200" viewBox="0 0 24 24" fill="currentColor"
        style="transform: ${pilRotation(grader)}" aria-hidden="true">
        <path d="${PIL_PATH}" />
      </svg>
      <span class="sr-only">fra ${retningTekst(grader)}</span>
      <span class="text-sm font-bold">${Math.round(ms)}</span>
    </li>`;
  }

  async function initVindBoks(el: HTMLElement) {
    const q = (sel: string) => el.querySelector<HTMLElement>(sel)!;
    const url = forecastUrl({
      latitude: el.dataset.lat!,
      longitude: el.dataset.lng!,
      current: 'temperature_2m,wind_speed_10m,wind_direction_10m,wind_gusts_10m',
      hourly: 'wind_speed_10m,wind_gusts_10m,wind_direction_10m',
      forecast_days: '2',
    });

    try {
      const res = await fetch(url, { signal: AbortSignal.timeout(10_000) });
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      const data = await res.json();
      const { current, hourly } = data;

      q('[data-vb-vind]').textContent = fmt.format(current.wind_speed_10m);
      q('[data-vb-retning]').textContent = `fra ${retningTekst(current.wind_direction_10m)}`;
      q('[data-vb-stoed]').textContent = fmt.format(current.wind_gusts_10m);
      q('[data-vb-temp]').textContent = fmt.format(current.temperature_2m);
      q('[data-vb-pil]').style.transform = pilRotation(current.wind_direction_10m);
      q('[data-vb-tid]').textContent = current.time.slice(11, 16);

      const badge = q('[data-vb-badge]');
      badge.textContent = betegnelse(current.wind_speed_10m);
      badge.className += ` ${BADGE_FARVER[niveau(current.wind_speed_10m)]}`;
      badge.hidden = false;

      const fraIndex = hourly.time.findIndex((t: string) => t > current.time);
      q('[data-vb-timer]').innerHTML = hourly.time
        .slice(fraIndex, fraIndex + 9)
        .map((t: string, i: number) =>
          timeKort(t, hourly.wind_speed_10m[fraIndex + i], hourly.wind_direction_10m[fraIndex + i]))
        .join('');

      q('[data-vb-indhold]').hidden = false;
    } catch {
      q('[data-vb-fejl]').hidden = false;
    } finally {
      q('[data-vb-skelet]').remove();
    }
  }

  document.querySelectorAll<HTMLElement>('[data-vindboks]').forEach(initVindBoks);
</script>
