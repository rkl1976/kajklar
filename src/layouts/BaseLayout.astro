---
import '@fontsource-variable/fraunces';
import '@fontsource-variable/instrument-sans';
import '../styles/global.css';
import { withBase } from '../lib/url';

interface Props {
  title: string;
  description: string;
  bred?: boolean;
  ogType?: string;
}

const { title, description, bred = false, ogType = 'website' } = Astro.props;
const nav = [
  { href: withBase('/laer-at-sejle/'), label: 'Lær at sejle' },
  { href: withBase('/havnemanoevrer/'), label: 'Havnemanøvrer' },
  { href: withBase('/regler/'), label: 'Regler' },
  { href: withBase('/vejr/'), label: 'Vejr' },
  { href: withBase('/logbog/'), label: 'Logbog' },
];
---
<!doctype html>
<html lang="da">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <title>{title} · KajKlar</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site)} />
    <link rel="sitemap" href={withBase('/sitemap-index.xml')} />
    <meta property="og:title" content={`${title} · KajKlar`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <script is:inline>
      const theme = localStorage.getItem('theme')
        ?? (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      document.documentElement.classList.toggle('dark', theme === 'dark');
    </script>
  </head>
  <body class="flex min-h-screen flex-col bg-white font-sans text-fjord-900 dark:bg-slate-900 dark:text-slate-100">
    <header class="sticky top-0 z-40 border-b border-fjord-100/70 bg-white/80 backdrop-blur-md dark:border-slate-700/70 dark:bg-slate-900/80">
      <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-x-4 gap-y-2 px-4 py-3">
        <a href={withBase('/')} class="font-display text-xl font-black tracking-tight text-fjord-700 dark:text-fjord-200">⚓ KajKlar</a>
        <nav class="flex flex-wrap items-center gap-x-5 gap-y-1 text-sm font-medium" aria-label="Hovedmenu">
          {nav.map((item) => (
            <a href={item.href} class="transition-colors hover:text-fjord-600 dark:hover:text-fjord-200">{item.label}</a>
          ))}
          <button id="theme-toggle" type="button" aria-label="Skift mellem lys og mørk visning"
            class="rounded-full border border-fjord-100 px-2 py-1 transition-colors hover:border-fjord-500 dark:border-slate-600 dark:hover:border-fjord-200">🌓</button>
        </nav>
      </div>
    </header>
    <main class:list={['w-full flex-1', !bred && 'mx-auto max-w-5xl px-4 py-8']}>
      <slot />
    </main>
    <footer class="mt-16 border-t border-fjord-100 bg-fjord-50 dark:border-slate-700 dark:bg-slate-950">
      <div class="mx-auto grid max-w-6xl gap-8 px-4 py-10 sm:grid-cols-3">
        <div>
          <p class="font-display text-lg font-black text-fjord-700 dark:text-fjord-200">⚓ KajKlar</p>
          <p class="mt-2 max-w-xs text-sm text-slate-600 dark:text-slate-400">
            Guides, havnemanøvrer, regler og havneinfo for nye motorbådssejlere i Limfjorden.
          </p>
        </div>
        <nav class="text-sm" aria-label="Sidefod">
          <p class="font-semibold">Indhold</p>
          <ul class="mt-2 space-y-1.5 text-slate-600 dark:text-slate-400">
            {nav.map((item) => (
              <li><a href={item.href} class="hover:text-fjord-600 hover:underline dark:hover:text-fjord-200">{item.label}</a></li>
            ))}
            <li><a href={withBase('/om/')} class="hover:text-fjord-600 hover:underline dark:hover:text-fjord-200">Om sitet</a></li>
          </ul>
        </nav>
        <div class="text-sm text-slate-600 dark:text-slate-400">
          <p class="font-semibold text-fjord-900 dark:text-slate-100">Sejl på den sikre side</p>
          <p class="mt-2">KajKlar vejleder, officielle regler og kilder gælder altid. Du sejler på eget ansvar.</p>
          <p class="mt-2"><a href={withBase('/om/')} class="underline hover:text-fjord-600 dark:hover:text-fjord-200">Læs ansvarsfraskrivelsen</a></p>
        </div>
      </div>
    </footer>
    <script is:inline>
      document.getElementById('theme-toggle')?.addEventListener('click', () => {
        const isDark = document.documentElement.classList.toggle('dark');
        localStorage.setItem('theme', isDark ? 'dark' : 'light');
      });
    </script>
  </body>
</html>
